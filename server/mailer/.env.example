# Copier en .env (jamais commité). Toutes les valeurs sont propres à l'environnement.
PORT=8787
BRAND_NAME=Love Ink
APP_BASE_URL=https://loveink.site
ACTION_PATH=/auth-action.html
# Expéditeur : en dev sans domaine vérifié, Resend n'accepte que onboarding@resend.dev vers votre propre adresse.
MAIL_FROM=Love Ink <onboarding@resend.dev>
MAIL_REPLY_TO=
RESEND_API_KEY=re_xxxxxxxxx
# Origines autorisées (CORS), séparées par des virgules.
ALLOWED_ORIGINS=https://loveink.site,https://love-ink.web.app,http://127.0.0.1:5178,http://localhost:5178
RATE_WINDOW_MS=900000
RATE_MAX=5
# 1 = expose GET /preview/verification et /preview/passwordReset (dev uniquement)
MAILER_PREVIEW=0
MAIL_LOGO_URL=
# Compte de service Firebase : soit un chemin de fichier, soit le JSON inline.
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON=

# Port hôte publié sur 127.0.0.1 (le conteneur écoute toujours sur PORT).
HOST_PORT=8787
